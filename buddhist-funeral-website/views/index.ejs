<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title><%= c.site.metaTitle %></title>
<meta name="description" content="<%= c.site.metaDescription %>">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&family=Jost:wght@300;400;500;600&family=Noto+Serif+SC:wght@400;600&display=swap" rel="stylesheet">
<style>
:root{
  --ivory:#f7f1e6;
  --ivory-deep:#efe6d4;
  --brown:#3b2f24;
  --brown-soft:#5c4c3c;
  --gold:#b08d4a;
  --gold-light:#d6b878;
  --maroon:#7a3b2e;
  --white:#fffdf8;
}
*{margin:0;padding:0;box-sizing:border-box}
html{scroll-behavior:smooth}
body{font-family:'Jost',sans-serif;color:var(--brown-soft);background:var(--ivory);line-height:1.75;font-weight:300}
h1,h2,h3,h4{font-family:'Cormorant Garamond',serif;color:var(--brown);line-height:1.25}
.zh{font-family:'Noto Serif SC',serif}
img,svg{max-width:100%;display:block}
a{text-decoration:none;color:inherit}
.container{max-width:1100px;margin:0 auto;padding:0 24px}
.eyebrow{display:inline-block;font-size:.78rem;letter-spacing:.3em;text-transform:uppercase;color:var(--gold);font-weight:500;margin-bottom:14px}
.section-title{font-size:clamp(2rem,4vw,2.7rem);font-weight:600;margin-bottom:16px}
.section-title em{font-style:italic;color:var(--gold)}
.lead{font-size:1.05rem;max-width:660px}
section{padding:90px 0}
.rule{width:60px;height:2px;background:linear-gradient(90deg,var(--gold),var(--gold-light));margin:22px 0}
.btn{display:inline-block;padding:13px 32px;border-radius:40px;font-size:.85rem;letter-spacing:.14em;text-transform:uppercase;font-weight:500;transition:all .3s}
.btn-gold{background:linear-gradient(135deg,var(--gold),var(--gold-light));color:var(--white)}
.btn-gold:hover{box-shadow:0 8px 26px rgba(176,141,74,.4);transform:translateY(-2px)}
.btn-outline{border:1px solid var(--gold);color:var(--gold)}
.btn-outline:hover{background:var(--gold);color:var(--white)}

/* NAV */
nav{position:fixed;top:0;left:0;right:0;z-index:100;background:rgba(59,47,36,.95);backdrop-filter:blur(10px);border-bottom:1px solid rgba(214,184,120,.3)}
.nav-inner{max-width:1100px;margin:0 auto;padding:13px 24px;display:flex;align-items:center;justify-content:space-between;gap:18px}
.brand{display:flex;align-items:center;gap:12px;color:var(--gold-light)}
.brand svg{width:34px;height:34px}
.brand b{font-family:'Cormorant Garamond',serif;font-size:1.25rem;font-weight:600;letter-spacing:.06em}
.brand span{font-size:.95rem;opacity:.85}
.nav-links{display:flex;gap:28px;list-style:none;align-items:center}
.nav-links a{color:#e9ddc6;font-size:.85rem;letter-spacing:.12em;text-transform:uppercase;transition:color .25s}
.nav-links a:hover{color:var(--gold-light)}
.nav-hotline{background:var(--maroon);color:#fff;padding:9px 20px;border-radius:30px;font-size:.83rem;letter-spacing:.08em;white-space:nowrap}
.nav-hotline:hover{background:#8f4536}
@media(max-width:900px){.nav-links{display:none}}

/* HERO */
.hero{position:relative;min-height:92vh;display:flex;align-items:center;background:
 radial-gradient(ellipse at 75% 20%, rgba(214,184,120,.22), transparent 55%),
 linear-gradient(170deg,#fbf7ee 0%,var(--ivory) 50%,var(--ivory-deep) 100%);
 overflow:hidden;padding:150px 0 100px;text-align:center}
.hero.has-bg{background:none}
.hero-bg{position:absolute;inset:0;z-index:0}
.hero-bg img{width:100%;height:100%;object-fit:cover}
.hero-bg::after{content:'';position:absolute;inset:0;background:linear-gradient(180deg,rgba(59,47,36,.55),rgba(59,47,36,.72))}
.hero.has-bg .container{position:relative;z-index:2}
.hero.has-bg h1,.hero.has-bg .hero p{color:var(--white)}
.hero.has-bg h1{color:var(--white)}
.hero.has-bg p{color:#f3ecdd}
.hero-lotus{width:130px;margin:0 auto 30px;opacity:.95}
.hero h1{font-size:clamp(2.6rem,5.5vw,4rem);font-weight:600;margin-bottom:10px}
.hero h1 em{font-style:italic;color:var(--gold)}
.hero.has-bg h1 em{color:var(--gold-light)}
.hero .zh-line{font-family:'Noto Serif SC',serif;color:var(--gold);font-size:1.25rem;letter-spacing:.5em;margin-bottom:26px}
.hero.has-bg .zh-line{color:var(--gold-light)}
.hero p{max-width:600px;margin:0 auto 38px;font-size:1.08rem}
.hero-ctas{display:flex;gap:16px;justify-content:center;flex-wrap:wrap}
.ensoCircle{position:absolute;border-radius:50%;border:1px solid rgba(176,141,74,.18);pointer-events:none}
.e1{width:560px;height:560px;left:-180px;bottom:-220px}
.e2{width:380px;height:380px;right:-120px;top:-90px;border-color:rgba(176,141,74,.25)}

/* HOTLINE STRIP */
.strip{background:var(--maroon);padding:26px 0}
.strip .container{display:flex;align-items:center;justify-content:space-between;gap:20px;flex-wrap:wrap}
.strip p{color:#f3e3d8;font-size:1.02rem}
.strip b{font-family:'Cormorant Garamond',serif;font-size:1.5rem;color:#fff;font-weight:600;letter-spacing:.04em}
.strip .btn{background:#fff;color:var(--maroon);padding:11px 26px}
.strip .btn:hover{background:var(--ivory)}

/* STEPS */
.steps{background:var(--white)}
.steps-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:24px;margin-top:50px}
.step{background:var(--ivory);border:1px solid var(--ivory-deep);border-radius:16px;padding:30px 24px;position:relative}
.step i{font-style:normal;display:inline-flex;width:42px;height:42px;border-radius:50%;background:linear-gradient(135deg,var(--gold),var(--gold-light));color:#fff;align-items:center;justify-content:center;font-family:'Cormorant Garamond',serif;font-size:1.3rem;font-weight:700;margin-bottom:16px}
.step h3{font-size:1.25rem;font-weight:600;margin-bottom:8px}
.step p{font-size:.92rem}
@media(max-width:900px){.steps-grid{grid-template-columns:repeat(2,1fr)}}
@media(max-width:560px){.steps-grid{grid-template-columns:1fr}}

/* SERVICES */
.services{background:linear-gradient(180deg,var(--ivory),var(--ivory-deep))}
.svc-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:26px;margin-top:50px}
.svc{background:var(--white);border-radius:18px;padding:36px 30px;box-shadow:0 10px 34px rgba(59,47,36,.08);transition:transform .3s,box-shadow .3s;border-top:3px solid var(--gold-light)}
.svc:hover{transform:translateY(-5px);box-shadow:0 18px 46px rgba(59,47,36,.13)}
.svc svg{width:46px;height:46px;margin-bottom:18px}
.svc h3{font-size:1.35rem;font-weight:600;margin-bottom:10px}
.svc p{font-size:.93rem}
@media(max-width:900px){.svc-grid{grid-template-columns:1fr 1fr}}
@media(max-width:560px){.svc-grid{grid-template-columns:1fr}}

/* GALLERY */
.gallery{background:var(--white)}
.gallery-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:20px;margin-top:50px}
.gallery-item{position:relative;border-radius:16px;overflow:hidden;box-shadow:0 10px 30px rgba(59,47,36,.1);aspect-ratio:4/3}
.gallery-item img{width:100%;height:100%;object-fit:cover;transition:transform .5s}
.gallery-item:hover img{transform:scale(1.05)}
.gallery-item span{position:absolute;left:0;right:0;bottom:0;padding:30px 18px 14px;color:#fff;font-size:.9rem;background:linear-gradient(180deg,transparent,rgba(42,33,24,.8))}
@media(max-width:900px){.gallery-grid{grid-template-columns:1fr 1fr}}
@media(max-width:560px){.gallery-grid{grid-template-columns:1fr}}

/* RITES */
.rites{background:var(--brown);position:relative;overflow:hidden}
.rites::before{content:'';position:absolute;right:-140px;top:-140px;width:480px;height:480px;border-radius:50%;border:1px solid rgba(214,184,120,.18)}
.rites .eyebrow{color:var(--gold-light)}
.rites .section-title{color:var(--ivory)}
.rites .lead{color:#cdbfa8}
.rites-grid{display:grid;grid-template-columns:1fr 1fr;gap:22px;margin-top:50px;position:relative;z-index:2}
.rite{background:rgba(255,253,248,.06);border:1px solid rgba(214,184,120,.28);border-radius:16px;padding:28px 28px}
.rite h3{color:var(--gold-light);font-size:1.3rem;font-weight:600;margin-bottom:8px}
.rite h3 span{font-family:'Noto Serif SC',serif;font-size:1.05rem;margin-left:10px;opacity:.85}
.rite p{color:#d9cdb8;font-size:.94rem}
@media(max-width:860px){.rites-grid{grid-template-columns:1fr}}

/* PACKAGES */
.packages{background:var(--white)}
.pkg-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:26px;margin-top:50px}
.pkg{border:1px solid var(--ivory-deep);border-radius:20px;padding:38px 32px;background:var(--ivory);position:relative;transition:transform .3s,box-shadow .3s}
.pkg:hover{transform:translateY(-5px);box-shadow:0 18px 46px rgba(59,47,36,.12)}
.pkg.featured{background:linear-gradient(170deg,#fdfaf3,var(--ivory));border:1px solid var(--gold-light)}
.pkg .tag{position:absolute;top:-13px;left:50%;transform:translateX(-50%);background:linear-gradient(135deg,var(--gold),var(--gold-light));color:#fff;font-size:.72rem;letter-spacing:.18em;text-transform:uppercase;padding:5px 18px;border-radius:30px;white-space:nowrap}
.pkg h3{font-size:1.5rem;font-weight:600;text-align:center;margin-bottom:4px}
.pkg .days{text-align:center;color:var(--gold);font-style:italic;font-family:'Cormorant Garamond',serif;font-size:1.05rem;margin-bottom:22px}
.pkg ul{list-style:none}
.pkg li{padding:9px 0 9px 26px;font-size:.92rem;border-bottom:1px dashed var(--ivory-deep);position:relative}
.pkg li::before{content:'☸';position:absolute;left:0;color:var(--gold);font-size:.85rem}
.pkg li:last-child{border-bottom:none}
.pkg .btn{display:block;text-align:center;margin-top:24px}
@media(max-width:900px){.pkg-grid{grid-template-columns:1fr}}

/* FAQ */
.faq{background:linear-gradient(180deg,var(--ivory),var(--ivory-deep))}
.faq details{background:var(--white);border-radius:14px;margin-top:16px;border:1px solid var(--ivory-deep);overflow:hidden}
.faq summary{cursor:pointer;padding:20px 26px;font-family:'Cormorant Garamond',serif;font-size:1.2rem;font-weight:600;color:var(--brown);list-style:none;position:relative}
.faq summary::after{content:'+';position:absolute;right:24px;color:var(--gold);font-size:1.4rem;transition:transform .25s}
.faq details[open] summary::after{transform:rotate(45deg)}
.faq details p{padding:0 26px 22px;font-size:.95rem}

/* CONTACT */
.contact{background:var(--brown)}
.contact .eyebrow{color:var(--gold-light)}
.contact .section-title{color:var(--ivory)}
.contact-grid{display:grid;grid-template-columns:1fr 1fr;gap:46px;margin-top:30px}
.contact-card{background:rgba(255,253,248,.06);border:1px solid rgba(214,184,120,.3);border-radius:18px;padding:34px;color:#d9cdb8}
.contact-card h3{color:var(--gold-light);font-size:1.35rem;margin-bottom:18px}
.cl{display:flex;gap:14px;margin-bottom:15px;font-size:.97rem;align-items:baseline}
.cl b{color:var(--gold-light);min-width:90px;font-weight:500;font-size:.78rem;letter-spacing:.12em;text-transform:uppercase}
.contact-note{background:rgba(122,59,46,.35);border:1px solid rgba(214,184,120,.25);border-radius:18px;padding:34px;color:#e9ddc6;display:flex;flex-direction:column;justify-content:center}
.contact-note h3{color:#fff;font-size:1.6rem;margin-bottom:10px}
.contact-note p{margin-bottom:22px}
@media(max-width:860px){.contact-grid{grid-template-columns:1fr}}

/* FOOTER */
footer{background:#2a2118;padding:34px 0;text-align:center}
footer p{color:#9b8a72;font-size:.82rem;letter-spacing:.05em}
footer .zh{color:var(--gold);font-size:1rem;margin-bottom:6px;letter-spacing:.4em}
</style>
</head>
<body>

<nav>
  <div class="nav-inner">
    <a href="#top" class="brand">
      <svg viewBox="0 0 64 64" fill="none"><path d="M32 14c4 7 5 13 0 20-5-7-4-13 0-20Z" fill="#d6b878"/><path d="M20 22c7 2 11 6 12 14-8-1-12-6-12-14Z" fill="#b08d4a"/><path d="M44 22c-7 2-11 6-12 14 8-1 12-6 12-14Z" fill="#b08d4a"/><path d="M12 34c7-1 13 1 18 7-7 3-14 0-18-7Z" fill="#d6b878"/><path d="M52 34c-7-1-13 1-18 7 7 3 14 0 18-7Z" fill="#d6b878"/><path d="M18 46c9-4 19-4 28 0-9 5-19 5-28 0Z" fill="#b08d4a"/></svg>
      <div><b><%= c.site.brandTop %></b> <span><%= c.site.brandBottom %></span></div>
    </a>
    <ul class="nav-links">
      <li><a href="#guidance">First Steps</a></li>
      <li><a href="#services">Services</a></li>
      <% if (c.gallery.items.length) { %><li><a href="#gallery">Gallery</a></li><% } %>
      <li><a href="#rites">Buddhist Rites</a></li>
      <li><a href="#packages">Packages</a></li>
      <li><a href="#contact">Contact</a></li>
    </ul>
    <a class="nav-hotline" href="tel:<%= c.site.hotlineTel %>">24-Hr Hotline · <%= c.site.hotline %></a>
  </div>
</nav>

<header class="hero <%= c.hero.backgroundImage ? 'has-bg' : '' %>" id="top">
  <% if (c.hero.backgroundImage) { %>
    <div class="hero-bg"><img src="<%= c.hero.backgroundImage %>" alt=""></div>
  <% } else { %>
    <span class="ensoCircle e1"></span><span class="ensoCircle e2"></span>
  <% } %>
  <div class="container">
    <% if (!c.hero.backgroundImage) { %>
    <svg class="hero-lotus" viewBox="0 0 120 90" fill="none">
      <path d="M60 8c8 13 10 25 0 38-10-13-8-25 0-38Z" fill="#d6b878"/>
      <path d="M36 20c13 4 21 12 23 27-15-2-22-12-23-27Z" fill="#b08d4a"/>
      <path d="M84 20c-13 4-21 12-23 27 15-2 22-12 23-27Z" fill="#b08d4a"/>
      <path d="M18 42c13-2 25 2 34 13-13 6-26 1-34-13Z" fill="#d6b878"/>
      <path d="M102 42c-13-2-25 2-34 13 13 6 26 1 34-13Z" fill="#d6b878"/>
      <path d="M30 64c18-8 42-8 60 0-18 10-42 10-60 0Z" fill="#b08d4a"/>
    </svg>
    <% } %>
    <h1><%= c.hero.title %> <em><%= c.hero.titleEm %></em></h1>
    <div class="zh-line"><%= c.hero.zhLine %></div>
    <p><%= c.hero.paragraph %></p>
    <div class="hero-ctas">
      <a href="tel:<%= c.site.hotlineTel %>" class="btn btn-gold"><%= c.hero.ctaPrimary %></a>
      <a href="#packages" class="btn btn-outline"><%= c.hero.ctaSecondary %></a>
    </div>
  </div>
</header>

<div class="strip">
  <div class="container">
    <p><%= c.strip.text %><br><b><%= c.site.hotline %></b></p>
    <a class="btn" href="https://wa.me/<%= c.site.whatsapp %>"><%= c.strip.button %></a>
  </div>
</div>

<section class="steps" id="guidance">
  <div class="container">
    <span class="eyebrow"><%= c.steps.eyebrow %></span>
    <h2 class="section-title"><%= c.steps.title %> <em><%= c.steps.titleEm %></em></h2>
    <div class="rule"></div>
    <p class="lead"><%= c.steps.lead %></p>
    <div class="steps-grid">
      <% c.steps.items.forEach(function(item, i){ %>
      <div class="step"><i><%= i+1 %></i><h3><%= item.title %></h3><p><%= item.text %></p></div>
      <% }); %>
    </div>
  </div>
</section>

<section class="services" id="services">
  <div class="container">
    <span class="eyebrow"><%= c.services.eyebrow %></span>
    <h2 class="section-title"><%= c.services.title %> <em><%= c.services.titleEm %></em></h2>
    <div class="rule"></div>
    <p class="lead"><%= c.services.lead %></p>
    <%
      var svcIcons = [
        '<svg viewBox="0 0 48 48" fill="none"><rect x="8" y="20" width="32" height="18" rx="3" stroke="#b08d4a" stroke-width="2"/><path d="M12 20l12-9 12 9" stroke="#b08d4a" stroke-width="2" stroke-linecap="round"/><path d="M24 28v6" stroke="#d6b878" stroke-width="2" stroke-linecap="round"/></svg>',
        '<svg viewBox="0 0 48 48" fill="none"><circle cx="24" cy="24" r="16" stroke="#b08d4a" stroke-width="2"/><path d="M24 8v32M8 24h32M13 13l22 22M35 13L13 35" stroke="#d6b878" stroke-width="1.4"/></svg>',
        '<svg viewBox="0 0 48 48" fill="none"><path d="M10 34h28l-4-20H14l-4 20Z" stroke="#b08d4a" stroke-width="2" stroke-linejoin="round"/><path d="M19 14a5 5 0 0 1 10 0" stroke="#d6b878" stroke-width="2"/></svg>',
        '<svg viewBox="0 0 48 48" fill="none"><path d="M24 6c6 8 8 14 0 22-8-8-6-14 0-22Z" stroke="#b08d4a" stroke-width="2"/><path d="M10 30c8 0 12 3 14 10 2-7 6-10 14-10" stroke="#d6b878" stroke-width="2" stroke-linecap="round"/></svg>',
        '<svg viewBox="0 0 48 48" fill="none"><rect x="10" y="10" width="28" height="28" rx="4" stroke="#b08d4a" stroke-width="2"/><path d="M17 24h14M24 17v14" stroke="#d6b878" stroke-width="2" stroke-linecap="round"/></svg>',
        '<svg viewBox="0 0 48 48" fill="none"><path d="M8 38V14l10 6 6-10 6 10 10-6v24H8Z" stroke="#b08d4a" stroke-width="2" stroke-linejoin="round"/></svg>'
      ];
    %>
    <div class="svc-grid">
      <% c.services.items.forEach(function(item, i){ %>
      <div class="svc">
        <%- svcIcons[i % svcIcons.length] %>
        <h3><%= item.title %></h3>
        <p><%= item.text %></p>
      </div>
      <% }); %>
    </div>
  </div>
</section>

<% if (c.gallery.items.length) { %>
<section class="gallery" id="gallery">
  <div class="container">
    <span class="eyebrow"><%= c.gallery.eyebrow %></span>
    <h2 class="section-title"><%= c.gallery.title %> <em><%= c.gallery.titleEm %></em></h2>
    <div class="rule"></div>
    <p class="lead"><%= c.gallery.lead %></p>
    <div class="gallery-grid">
      <% c.gallery.items.forEach(function(item){ %>
      <div class="gallery-item">
        <img src="<%= item.image %>" alt="<%= item.caption %>">
        <% if (item.caption) { %><span><%= item.caption %></span><% } %>
      </div>
      <% }); %>
    </div>
  </div>
</section>
<% } %>

<section class="rites" id="rites">
  <div class="container">
    <span class="eyebrow"><%= c.rites.eyebrow %></span>
    <h2 class="section-title"><%= c.rites.title %> <em><%= c.rites.titleEm %></em></h2>
    <div class="rule"></div>
    <p class="lead"><%= c.rites.lead %></p>
    <div class="rites-grid">
      <% c.rites.items.forEach(function(item){ %>
      <div class="rite"><h3><%= item.title %> <span class="zh"><%= item.zh %></span></h3><p><%= item.text %></p></div>
      <% }); %>
    </div>
  </div>
</section>

<section class="packages" id="packages">
  <div class="container">
    <span class="eyebrow"><%= c.packages.eyebrow %></span>
    <h2 class="section-title"><%= c.packages.title %> <em><%= c.packages.titleEm %></em></h2>
    <div class="rule"></div>
    <p class="lead"><%= c.packages.lead %></p>
    <div class="pkg-grid">
      <% c.packages.items.forEach(function(pkg){ %>
      <div class="pkg <%= pkg.featured ? 'featured' : '' %>">
        <% if (pkg.featured && pkg.tag) { %><span class="tag"><%= pkg.tag %></span><% } %>
        <h3><%= pkg.name %></h3>
        <div class="days"><%= pkg.days %></div>
        <ul>
          <% pkg.features.forEach(function(f){ %><li><%= f %></li><% }); %>
        </ul>
        <a href="#contact" class="btn <%= pkg.featured ? 'btn-gold' : 'btn-outline' %>">Enquire</a>
      </div>
      <% }); %>
    </div>
  </div>
</section>

<section class="faq">
  <div class="container">
    <span class="eyebrow"><%= c.faq.eyebrow %></span>
    <h2 class="section-title"><%= c.faq.title %> <em><%= c.faq.titleEm %></em></h2>
    <div class="rule"></div>
    <% c.faq.items.forEach(function(item){ %>
    <details>
      <summary><%= item.q %></summary>
      <p><%= item.a %></p>
    </details>
    <% }); %>
  </div>
</section>

<section class="contact" id="contact">
  <div class="container">
    <span class="eyebrow"><%= c.contact.eyebrow %></span>
    <h2 class="section-title"><%= c.contact.title %> <em><%= c.contact.titleEm %></em></h2>
    <div class="rule"></div>
    <div class="contact-grid">
      <div class="contact-card">
        <h3><%= c.contact.cardTitle %> <span class="zh"><%= c.contact.cardZh %></span></h3>
        <p style="font-size:.85rem;opacity:.8;margin-bottom:18px"><%= c.contact.cardSubtitle %></p>
        <div class="cl"><b>Hotline</b><span><%= c.site.hotline %> — 24 hours</span></div>
        <div class="cl"><b>WhatsApp</b><span><%= c.site.whatsapp %></span></div>
        <div class="cl"><b>Email</b><span><%= c.site.email %></span></div>
        <div class="cl"><b>Address</b><span><%= c.site.address %></span></div>
      </div>
      <div class="contact-note">
        <h3><%= c.contact.noteTitle %></h3>
        <p><%= c.contact.noteText %></p>
        <div><a class="btn btn-gold" href="tel:<%= c.site.hotlineTel %>"><%= c.contact.noteButton %></a></div>
      </div>
