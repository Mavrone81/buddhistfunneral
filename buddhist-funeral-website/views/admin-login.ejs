<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Admin Login · Singapore Buddhist Funeral Services</title>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600&family=Jost:wght@300;400;500&display=swap" rel="stylesheet">
<style>
*{margin:0;padding:0;box-sizing:border-box}
body{font-family:'Jost',sans-serif;background:linear-gradient(170deg,#3b2f24,#2a2118);color:#e9ddc6;min-height:100vh;display:flex;align-items:center;justify-content:center;padding:24px}
.card{background:rgba(255,253,248,.05);border:1px solid rgba(214,184,120,.3);border-radius:18px;padding:46px 40px;width:100%;max-width:380px;text-align:center}
.lotus{width:64px;margin:0 auto 18px}
h1{font-family:'Cormorant Garamond',serif;font-size:1.7rem;font-weight:600;color:#f7f1e6;margin-bottom:6px}
.sub{font-size:.85rem;color:#b9a988;margin-bottom:30px;letter-spacing:.05em}
label{display:block;text-align:left;font-size:.75rem;letter-spacing:.14em;text-transform:uppercase;color:#d6b878;margin-bottom:8px}
input{width:100%;padding:13px 16px;border-radius:10px;border:1px solid rgba(214,184,120,.35);background:rgba(0,0,0,.2);color:#fff;font-size:1rem;font-family:inherit}
input:focus{outline:none;border-color:#d6b878}
button{width:100%;margin-top:22px;padding:13px;border:none;border-radius:30px;background:linear-gradient(135deg,#b08d4a,#d6b878);color:#fffdf8;font-size:.85rem;letter-spacing:.14em;text-transform:uppercase;font-weight:500;cursor:pointer;transition:.3s}
button:hover{box-shadow:0 8px 26px rgba(176,141,74,.4);transform:translateY(-2px)}
.err{background:rgba(122,59,46,.4);border:1px solid rgba(214,184,120,.3);color:#f3d8cf;padding:11px;border-radius:10px;font-size:.88rem;margin-bottom:20px}
a.back{display:inline-block;margin-top:22px;font-size:.8rem;color:#b9a988}
a.back:hover{color:#d6b878}
</style>
</head>
<body>
  <form class="card" method="post" action="/admin/login">
    <svg class="lotus" viewBox="0 0 120 90" fill="none">
      <path d="M60 8c8 13 10 25 0 38-10-13-8-25 0-38Z" fill="#d6b878"/>
      <path d="M36 20c13 4 21 12 23 27-15-2-22-12-23-27Z" fill="#b08d4a"/>
      <path d="M84 20c-13 4-21 12-23 27 15-2 22-12 23-27Z" fill="#b08d4a"/>
      <path d="M18 42c13-2 25 2 34 13-13 6-26 1-34-13Z" fill="#d6b878"/>
      <path d="M102 42c-13-2-25 2-34 13 13 6 26 1 34-13Z" fill="#d6b878"/>
      <path d="M30 64c18-8 42-8 60 0-18 10-42 10-60 0Z" fill="#b08d4a"/>
    </svg>
    <h1>Admin Panel</h1>
    <p class="sub">Singapore Buddhist Funeral Services</p>
    <% if (error) { %><div class="err"><%= error %></div><% } %>
    <label for="password">Password</label>
    <input type="password" id="password" name="password" autofocus required>
    <button type="submit">Sign In</button>
    <a class="back" href="/">← Back to website</a>
  </form>
</body>
</html>
