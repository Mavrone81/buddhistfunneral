<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title><%= pageTitle %></title>
<meta name="description" content="<%= pageDesc %>">
<link rel="canonical" href="https://singaporebuddhistfuneral.com.sg<%= canonicalPath %>">
<link rel="alternate" hreflang="en" href="https://singaporebuddhistfuneral.com.sg<%= enPath %>">
<link rel="alternate" hreflang="zh-SG" href="https://singaporebuddhistfuneral.com.sg<%= zhPath %>">
<link rel="alternate" hreflang="x-default" href="https://singaporebuddhistfuneral.com.sg<%= enPath %>">
<% if (c.site.favicon) { %>
<link rel="icon" href="<%= c.site.favicon %>">
<link rel="apple-touch-icon" href="<%= c.site.favicon %>">
<% } else { %>
<link rel="icon" type="image/svg+xml" href="/favicon.svg">
<link rel="apple-touch-icon" href="/favicon.svg">
<% } %>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Noto+Serif:ital,wght@0,400;0,600;1,500&family=Noto+Sans:wght@400;500;600&family=Noto+Serif+SC:wght@400;600&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/css/site.css">
<% (typeof jsonLd !== 'undefined' ? jsonLd : []).forEach(function(o){ %>
<script type="application/ld+json"><%- JSON.stringify(o).replace(/</g, '\\u003c') %></script>
<% }); %>
</head>
